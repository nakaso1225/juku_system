# ローカル開発用。このファイルを .dev.vars にコピーして使う（.dev.vars は git に入れない）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_SECRET=ローカル用の長いランダム文字列
# 最初の事務アカウント（カンマ区切り）。あとは管理画面から追加できる
ADMIN_EMAILS=admin@example.com
# 1 にすると Google を使わずにログインできる（ローカル専用。本番では絶対に設定しない）
DEV_LOGIN=1
# comiru 連携（本番は wrangler secret で登録）。ローカルでは偽の comiru に向けてテストできる
COMIRU_TOKEN=
COMIRU_SCHOOL_ID=
# COMIRU_API_BASE_URL=http://127.0.0.1:9999
