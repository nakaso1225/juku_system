/**
 * すでに登録されている授業情報を再度登録しようとしていないかを確認するための処理に関するファイル
 * 思っていたよりもシンプルな実装で実現できたのでファイルを分ける必要はなかったかも
 */
/**
 * coma_idが一致している授業一覧を受け取り、その中に生徒名と講師名が一致している授業が存在しているかどうかを確認する関数
 * absentがtrueの場合は欠席で登録されているものなのでabsentがtrueになっているものは無視する(この処理で良いのかは要確認)
 */
function checkIsDuplicated(seats, registerInfo) {
  if (seats === null) {
    return false;
  }
  // 生徒名と講師名が一致するかを順にfilterする
  const sameStudentAndTeacher = seats
    .filter((seat) => {
      return seat.student_name === registerInfo.studentName;
    })
    .filter((seat) => {
      return seat.teacher_name === registerInfo.teacherName;
    })
    .filter((seat) => {
      return seat.absent === false;
    });
  // 両方とも一致する授業が存在する場合には重複して登録しようとしていると判断する
  if (sameStudentAndTeacher.length) {
    Logger.log("This lesson data has already been registered.");
    return true;
  }
  return false;
}
/**
 * 授業登録時に "classroom" の値が既存の授業と被っているとエラーが出て登録できないので
 * 該当日時・時限のすでに登録されている授業一覧を取得して、それに被らないclassroomを見つける関数を定義するファイル
 *
 * 少し処理が重たくなるのでファイルを分割した
 */
/**
 * 使用されていないclassroomを見つける関数
 */
function findUnusedClassroom(seats) {
  if (seats === null) {
    return "A";
  }
  const isUsedClassroomList = getIsUsedClassroomListFromSeatsData(seats);
  const targetClassroomStr = findFirstUnusedClassroomStr(isUsedClassroomList);
  return targetClassroomStr;
}
/**
 * 授業情報から該当コマ(開始時刻と終了時刻が一致している)のclassroom情報を集め、
 * 使用されているclassroomはtrue, 使用されていないclassroomはfalseとした配列を返却する関数
 */
function getIsUsedClassroomListFromSeatsData(seats) {
  // 授業情報を一つずつ確認してclassroomを取得する
  const classroomStrList = seats.map((seat) => {
    return seat.classroom;
  });
  Logger.log(`classroomStrList: ${classroomStrList}`);
  // nullではないclassroomのアルファベットをindexに変換する
  const classroomIndexList = classroomStrList
    .filter((data) => data !== null)
    .map((classroomStr) => alphabetToNumber(classroomStr));
  // A-Z, αの27個分の配列を用意し、該当するアルファベットの部分をtrue, そうでない部分をfalseとした配列を取得する
  const isUsedClassroomList = range(27).map((i) => {
    if (classroomIndexList.includes(i)) {
      return true;
    }
    return false;
  });
  Logger.log(`isUsedClassroomList: ${isUsedClassroomList}`);
  return isUsedClassroomList;
}
/**
 * アルファベットから0-25の数字に変換する関数
 * αの場合は26を返す
 */
function alphabetToNumber(char) {
  if (char === "α") {
    return 26;
  }
  return char.charCodeAt(0) - 65;
}
/**
 * 与えられたisUsedClassroomListから最初に出てくる未使用のclassroomをアルファベット表記した文字列を取得する関数
 */
function findFirstUnusedClassroomStr(isUsedClassroomList) {
  // usedClassrooms配列に出てくる最初のfalseのindexを検索する
  const targetIndex = isUsedClassroomList.indexOf(false);
  if (targetIndex === -1) {
    // 空いているclassroomがなかった場合はnullで登録する
    Logger.log(`Available classroom is not found.`);
    return null;
  }
  // 0-25まではアルファベット、26の場合だけ"α"という名前のclassroomとして登録されている
  const targetClassroomStr = numberToUpperAlphabet(targetIndex);
  Logger.log(`Classroom ${targetClassroomStr} is available.`);
  return targetClassroomStr;
}
/**
 * 0-25の数字を大文字アルファベットに変換する関数
 * 26の場合はαを返却する
 */
function numberToUpperAlphabet(n) {
  if (n === 26) {
    return "α";
  }
  return String.fromCharCode(65 + n); // 65 = 'A'
}
/**
 * 「授業登録」のシートに関するファイル
 */
/**
 * 授業登録を行うための関数
 * スプシから入力データを取得し、validなデータであればComiruに登録する
 */
function registerLessons() {
  const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(
    REGISTER_LESSONS_SHEET_NAME
  );
  // スプシから入力されたデータを取得する
  const lessonInfoList = inputLessonInfoList(sheet);
  // 登録が成功した行の「登録する」のチェックボックスを外すために保持するための配列
  const successRowIndexes = [];
  // 入力データを一つずつ確認し、validなデータをComiruに登録する
  const results = lessonInfoList.map((lessonInfo, i) => {
    const lineNumStr = (i + 5).toString().padStart(2, " ");
    Logger.log(`Trying to register input data in line ${lineNumStr}...`);
    // validなデータかどうかを確認し、invalidであった場合は登録をskipする
    const [isValid, invalidMessage] = checkIsValidLessonInfo(lessonInfo);
    if (!isValid) {
      Logger.log(`Line${lineNumStr} data is isvalid:\n${invalidMessage}`);
      return ["✖️", invalidMessage];
    }
    // apiを短時間に叩きすぎないようにするため以下を実行する前に0.5秒待つ。
    // 1ループあたり「空いているclassroom情報取得」と「授業情報登録」の際の計2回ずつapiを叩く
    // ※ Comiru APIのリクエスト制限は20回/秒 (推奨は5回以下/秒)
    // https://api.stage.comiru.com/docs/corporation-api#section/%E3%83%AA%E3%82%AF%E3%82%A8%E3%82%B9%E3%83%88%E6%95%B0
    Utilities.sleep(500);
    try {
      // lessonInfoからpayloadを作成してComiruに登録を行う
      const payload = createPayload(lessonInfo.registerInfo);
      if (payload === null) {
        Logger.log(
          `Line${lineNumStr} payload creation failed. Similar lesson data is already registered.`
        );
        showToast(`${lineNumStr}行目: 同様の授業情報がすでに登録されています`);
        return ["✖️", "同様の授業情報がすでに登録されています"];
      }
      Logger.log(
        `Line${lineNumStr} payload: ${JSON.stringify(payload, null, 2)}`
      );
      registerLessonWithPayload(payload);
      successRowIndexes.push(i);
      Logger.log(`Line${lineNumStr} data is registered successfully.`);
      showToast(`${lineNumStr}行目: 正常に登録されました`);
      return ["⭕️", ""];
    } catch (e) {
      Logger.log(`Line${lineNumStr} erred in registerLessons:\n` + e.message);
      showToast(`${lineNumStr}行目: エラーが発生しました\n${e.message}`);
      return ["✖️", e.message];
    }
  });
  // 実行結果をスプシに反映する
  const resultFirstRow = 5;
  const resultFirstColumn = 9;
  sheet
    .getRange(
      resultFirstRow, // row
      resultFirstColumn, // column
      results.length, // numRow
      results[0].length // numColumn
    )
    .setValues(results);
  Logger.log(`successRowIndexes: ` + JSON.stringify(successRowIndexes));
  // 登録が成功した行の「登録する」のチェックを外す
  for (row of successRowIndexes) {
    sheet.getRange(row + resultFirstRow, 1, 1, 1).uncheck();
  }
}
/**
 * 入力されたデータがvalidなものであるかどうかを確認する
 *
 * 返り値は [isValid, invalidMessage] (isValid: boolean, invalidMessage: string)
 */
function checkIsValidLessonInfo(lessonInfo) {
  if (lessonInfo.isValid) {
    // validな場合はエラーメッセージはundefinedにする
    return [true, undefined];
  }
  // --- invalid な入力の場合 ---
  // 「登録する」がtrueであることを確認する
  if (!lessonInfo.registerInfo.shouldRegister) {
    return [false, "「登録する」にチェックが入っていません"];
  }
  // その他の場合は「ノート」以外のセルに空欄があるものと判断する
  return [false, "入力必須項目が入力されていません"];
}
/**
 * lessonInfoからpayloadを作成する
 * 別のシートから情報を読み取る関数は該当シートのgsファイルに定義している
 *
 * ※ objectは { key: value } というような形で書くが、
 * { aaa: aaa } のように書ける場合は { aaa } と省略できる
 */
function createPayload(registerInfo) {
  const coma_id = getComaIdFromDisplayedName(registerInfo.comaDisplayedName);
  const date = formatDate(registerInfo.date);
  // 該当日時の授業情報を取得する
  const targetClassroomSeats = getTargetClassroomSeats(date, coma_id);
  const classroom = findUnusedClassroom(targetClassroomSeats);
  const note = registerInfo.note || undefined; // 空文字の場合はundefinedにする
  const teacher_id = getTeacherIdFromTeacherName(registerInfo.teacherName);
  const max_seats = 1; // 固定値
  const is_public = true; // 固定値
  const student_id = getStudentIdFromStudentName(registerInfo.studentName);
  const subject = registerInfo.subjectName;
  const students = [{ student_id, subject }];
  const isDuplicated = checkIsDuplicated(targetClassroomSeats, registerInfo);
  if (isDuplicated) {
    Logger.log(
      "Error - createPayload: 同様の授業情報がすでに登録されています。"
    );
    return null;
  }
  const payload = {
    coma_id,
    date,
    classroom,
    ...(note?.trim() && { note }), // noteの中身がない(undefined)の場合は展開した際に削除される
    teacher_id,
    max_seats,
    is_public,
    students,
  };
  return payload;
}
/**
 * 該当日時の授業情報を取得し、該当コマの情報だけを抜き出す
 */
function getTargetClassroomSeats(date, comaId) {
  const seats = fetchSeatsByDate(date);
  if (seats === null) {
    return null;
  }
  // スプシの情報を用いてコマIDから開始時刻と終了時刻を取得する
  const [startTime, endTime] = getStartAndEndTimeByComaId(comaId);
  Logger.log(
    `coma_id: ${comaId}\n\t-> start_time=${startTime}, end_time=${endTime}`
  );
  // コマ情報(開始時刻と終了時刻)が一致する授業情報のみをfilterする
  const targetClassroomSeats = seats
    .filter((seat) => {
      return seat.start_time === startTime && seat.end_time === endTime;
    })
    .map((seat) => {
      // 項目数が多いため、必要な項目だけを返すようにする
      return {
        id: seat.id,
        date: seat.date,
        start_time: seat.start_time,
        end_time: seat.end_time,
        classroom: seat.classroom,
        teacher_name: seat.teacher.name,
        student_name: seat.seat_students?.[0]?.student_name ?? null,
        subject: seat.seat_students?.[0]?.subject ?? null,
        absent: seat.seat_students?.[0]?.absent ?? false,
      };
    });
  Logger.log(
    `targetClassroomSeats: ${JSON.stringify(targetClassroomSeats, null, 2)}`
  );
  return targetClassroomSeats;
}
/**
 * 指定した日にちの授業情報を取得する関数
 *
 * apiについては以下を参照
 * https://api.stage.comiru.com/docs/corporation-api#tag/%E5%BA%A7%E5%B8%AD%E7%AE%A1%E7%90%86/operation/corporationSeatIndex
 */
function fetchSeatsByDate(date) {
  const endpoint = `/${COMIRU_SCHOOL_ID}/seats`;
