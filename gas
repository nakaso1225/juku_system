/**
 * 「授業削除」のシートの授業削除機能に関するファイル
 */
function deleteLessons() {
  const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(
    DELETE_LESSONS_SHEET_NAME
  );
  const firstRow = 10;
  const lastRow = sheet.getLastRow();
  if (firstRow > lastRow) {
    alert("先に授業検索を行ってください");
    throw new Error("授業検索が行われていません");
  }
  if (!confirm("選択した授業を本当に削除しますか？")) {
    return;
  }
  // 現在の内容を削除
  const resultFirstColumn = 10;
  sheet
    .getRange(firstRow, resultFirstColumn, lastRow - firstRow + 1, 2)
    .clearContent();
  const lastColumn = resultFirstColumn - 2;
  const lessons = inputLessons(sheet, firstRow, lastRow, lastColumn);
  Logger.log(lessons);
  const results = lessons.map((lesson) => {
    if (!lesson.shouldDelete) {
      return ["", ""];
    }
    if (lesson.shouldDelete) {
      try {
        const msg = deleteLesson(lesson.seatId);
        return ["⭕️", msg];
      } catch (e) {
        return ["❌", e];
      }
    }
  });
  Logger.log(results);
  sheet
    .getRange(firstRow, resultFirstColumn, lastRow - firstRow + 1, 2)
    .setValues(results);
}
function inputLessons(sheet, firstRow, lastRow, lastColumn) {
  // 指定したCellの値を読み取る
  const inputValues = sheet
    .getRange(firstRow, 1, lastRow - firstRow + 1, lastColumn)
    .getValues();
  const lessons = inputValues.map((value) => {
    return {
      shouldDelete: value[0],
      teacherName: value[1],
      studentName: value[2],
      subject: value[3],
      comaName: value[4],
      date: value[5],
      seatId: value[6],
      classroom: value[7],
    };
  });
  return lessons;
}
function deleteLesson(seatId) {
  const endpoint = `/${COMIRU_SCHOOL_ID}/seats/${seatId}`;
  const [res, resCode] = callComiruDeleteApi(endpoint);
  if (resCode !== 200) {
    throw new Error(
      `Error - deleteLesson:\nResponseCode ${resCode}\n${res.message}`
    );
  }
  return res.message;
}
/**
 * 「授業削除」のシートの授業検索機能に関するファイル
 */
function searchLessons() {
  const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(
    DELETE_LESSONS_SHEET_NAME
  );
  const searchValues = inputValues(sheet);
  const {
    teacherId,
    studentId,
    startDate,
    endDate,
    startTime,
    endTime,
    subjectName,
  } = formatInputValues(searchValues);
  // 授業を検索
  const seats = fetchSeats(teacherId, studentId, startDate, endDate);
  const filteredSeats = filterSeats(seats, startTime, endTime, subjectName);
  Logger.log(`filteredSeats: ${JSON.stringify(filteredSeats, null, 2)}`);
  const outputs = formatOutputs(filteredSeats);
  Logger.log(`outputs: ${JSON.stringify(outputs, null, 2)}`);
  const firstRow = 10;
  const lastRow = sheet.getLastRow();
  const lastColumn = sheet.getLastColumn();
  // 現在の内容を削除
  if (firstRow < lastRow) {
    sheet
      .getRange(firstRow, 2, lastRow - firstRow + 1, lastColumn - 1)
      .clearContent();
    sheet.getRange(firstRow, 1, lastRow - firstRow + 1, 1).removeCheckboxes();
  }
  // outputsが存在するなら書き込みを行う
  if (outputs && outputs.length > 0) {
    sheet.getRange(firstRow, 1, outputs.length, 1).insertCheckboxes();
    sheet
      .getRange(firstRow, 2, outputs.length, outputs[0].length)
      .setValues(outputs);
  }
}
function inputValues(sheet) {
  const inputRange = "B3:G3";
  // 指定したCellの値を読み取る
  const inputValues = sheet.getRange(inputRange).getValues()[0];
  const searchValues = {
    teacherName: inputValues[0],
    studentName: inputValues[1],
    subjectName: inputValues[2],
    comaName: inputValues[3],
    startDate: inputValues[4],
    endDate: inputValues[5],
  };
  return searchValues;
}
// 授業検索に必要な情報をformat
function formatInputValues(searchValues) {
  const teacherName = searchValues.teacherName;
  const studentName = searchValues.studentName;
  const teacherId = teacherName
    ? getTeacherIdFromTeacherName(teacherName)
    : null;
  const studentId = studentName
    ? getStudentIdFromStudentName(studentName)
    : null;
  const date1 = searchValues.startDate;
  const date2 = searchValues.endDate;
  if (!date1 || !date2) {
    alert("検索開始日と終了日を両方入力してください");
    throw new Error("検索開始日と終了日が入力されていません");
  }
  const [startDate, endDate] = date1 < date2 ? [date1, date2] : [date2, date1];
  // 日付の差をミリ秒で計算
  const diffInMilliseconds = endDate.getTime() - startDate.getTime();
  // 終了日と開始日の差が3ヶ月を超えていないかをチェック
  if (diffInMilliseconds > ONE_MONTH_IN_MILLISECONDS * 3) {
    alert("検索開始日と終了日の差は3ヶ月以内にしてください");
    throw new Error(`検索開始日と終了日が3ヶ月以上離れています`);
  }
  const formattedStartDate = formatDate(startDate);
  const formattedEndDate = formatDate(endDate);
  const comaName = searchValues.comaName;
  const comaId = comaName ? getComaIdFromDisplayedName(comaName) : null;
  const [startTime, endTime] = comaId
    ? getStartAndEndTimeByComaId(comaId)
    : [null, null];
  const subjectName = searchValues.subjectName;
  return {
    teacherId,
    studentId,
    startDate: formattedStartDate,
    endDate: formattedEndDate,
    startTime,
    endTime,
    subjectName,
  };
}
/**
 * 指定した日にちの授業情報を取得する関数
 *
 * apiについては以下を参照
 * https://api.stage.comiru.com/docs/corporation-api#tag/%E5%BA%A7%E5%B8%AD%E7%AE%A1%E7%90%86/operation/corporationSeatIndex
 */
function fetchSeats(teacherId, studentId, startDate, endDate) {
  const endpoint = `/${COMIRU_SCHOOL_ID}/seats`;
  const results = [];
  for (let page = 1; ; page++) {
    const payload = {
      ...(teacherId && { teacher_id: teacherId }),
      ...(studentId && { student_id: studentId }),
      type: 0,
      start_date: startDate,
      end_date: endDate,
      page: page,
    };
    Logger.log(`payload: ${JSON.stringify(payload, null, 2)}`);
    const [res, resCode] = callComiruGetApi(endpoint, payload);
    if (resCode !== 200) {
      throw new Error(
        `Error - fetchSeats:\nResponseCode ${resCode}\n${res.message}`
      );
    }
    if (res.data.length === 0) {
      break;
    }
    results.push(res.data);
    Utilities.sleep(200);
  }
  return results.flat();
}
function filterSeats(seats, startTime, endTime, subjectName) {
  const filteredSeats = seats
    .map((data) => {
      return data.seats.filter((seat) => {
        // 授業の開始時間と科目が一致していることを確認する
        if (startTime && seat.start_time !== startTime) return false;
        if (endTime && seat.end_time !== endTime) return false;
        if (subjectName && seat.seat_students?.[0]?.subject !== subjectName)
          return false;
        return true;
      });
    })
    .map((data) => {
      return data.map((seat) => {
        // 項目数が多いため、必要な項目だけを返すようにする
        const comaName = getDisplayedNameFromStartAndEndTime(
          seat.start_time,
          seat.end_time
        );
        return {
          id: seat.id,
          date: seat.date,
          coma_name: comaName,
          teacher_name: seat.teacher.name,
          student_name: seat.seat_students[0].student_name ?? "",
          classroom: seat.classroom,
          subject: seat.seat_students[0].subject ?? "",
        };
      });
    });
  const flattenedSeats = filteredSeats.flat();
  return flattenedSeats;
}
function formatOutputs(seats) {
  const formattedSeats = seats.map((seat) => {
    return [
      seat.teacher_name,
      seat.student_name,
      seat.subject,
      seat.coma_name,
      formatDateWithDayOfWeekInJP(new Date(seat.date)),
      seat.id,
      seat.classroom,
    ];
  });
  return formattedSeats;
}
function formatDateWithDayOfWeekInJP(date) {
  const dayOfWeek = ["日", "月", "火", "水", "木", "金", "土"];
  const formatted =
    Utilities.formatDate(date, "Asia/Tokyo", "yyyy年MM月dd日") +
    "(" +
    dayOfWeek[date.getDay()] +
    ")";
  return formatted;
}
