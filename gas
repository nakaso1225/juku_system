/**
 * Pythonの range() のように、指定された範囲の連番配列を生成します。
 *
 * @param {number} start - 範囲の開始値。この引数のみが渡された場合は終了値として扱われ、開始値は0になります。
 * @param {number} [stop] - 範囲の終了値（この値は含まない）。
 * @param {number} [step=1] - 連番の増分。マイナスの値も指定可能です。
 *
 * @returns {number[]} 生成された数値の配列。
 */
function range(start, stop, step) {
  // 1. 引数の整理
  let actualStart = start;
  let actualStop = stop;
  let actualStep = step;
  // 引数が1つだけの場合: range(stop)
  if (actualStop === undefined) {
    actualStop = actualStart;
    actualStart = 0;
  }
  // 引数が1つだけor2つの場合: range(stop), range(start, stop)
  if (actualStep === undefined) {
    if (actualStart <= actualStop) {
      actualStep = 1;
    } else {
      actualStep = -1;
    }
  }
  // 2. エッジケースの処理
  if (actualStep === 0) {
    throw new Error(
      "Error - range: range() の step 引数に 0 は指定できません。"
    );
  }
  // 無効な範囲の場合は空の配列を返す
  if (
    (actualStep > 0 && actualStart >= actualStop) ||
    (actualStep < 0 && actualStart <= actualStop)
  ) {
    return [];
  }
  // 3. Array.from を使った配列の生成
  // 必要な要素の数を計算
  const length = Math.ceil((actualStop - actualStart) / actualStep);
  // Array.fromで配列を生成して返す
  return Array.from({ length }, (_, i) => actualStart + i * actualStep);
}
/**
 * 安全にurlを結合する関数。
 *
 * "https://example.com/" と "/api" のような文字列を結合する際に
 * 間の "/" が重複しないように結合してくれる。
 */
function joinUrl(...parts) {
  return parts
    .map((part, i) => {
      if (!part) return "";
      if (i === 0) return part.replace(/\/+$/, ""); // 最初の部分は末尾の `/` を除去
      return part.replace(/^\/+/, "").replace(/\/+$/, ""); // その他は前後の `/` を除去
    })
    .join("/");
}
/**
 * Comiru APIの実行を簡単に行うためのhelper関数。
 */
function callComiruApi(method, url, payload = undefined) {
  const scriptProperties = PropertiesService.getScriptProperties();
  const token = scriptProperties.getProperty("COMIRU_TOKEN");
  const options = {
    method: method,
    contentType: "application/json",
    headers: {
      Authorization: `Bearer ${token}`,
      Accept: "application/json",
    },
    muteHttpExceptions: true,
    // payloadの引数を受け取った場合のみ指定し、それ以外はundefinedにする
    payload: payload ? JSON.stringify(payload) : undefined,
  };
  Logger.log(
    `Calling Comiru API:\n[method]\t${method}\n[url]\t\t${url}\n[payload]\t${JSON.stringify(
      payload,
      null,
      2
    )}`
  );
  try {
    const response = UrlFetchApp.fetch(url, options);
    const responseBody = response.getContentText();
    const parsedJson = JSON.parse(responseBody);
    const responseCode = response.getResponseCode();
    return [parsedJson, responseCode];
  } catch (e) {
    Logger.log("Error - callComiruApi: " + e.message);
  }
}
/**
 * GET メソッドで Comiru APIを実行する helper 関数
 *
 * payload がある場合はquery paramsに変更する必要がある。
 */
function callComiruGetApi(endpoint, payload = undefined) {
  // GET method でpayloadが存在する場合は query parameterに変換する必要がある。
  // query parameterは "?a=1&b=2&c=3" のような形になる必要がある。
  const query = payload
    ? "?" +
      Object.entries(payload)
        .map(([k, v]) => `${encodeURIComponent(k)}=${encodeURIComponent(v)}`)
        .join("&")
    : "";
  // base_urlとendpointを結合し、必要があればqueryも付与する
  const url = joinUrl(COMIRU_API_BASE_URL, endpoint) + query;
  try {
    return callComiruApi("get", url);
  } catch (e) {
    Logger.log("Error - callComiruGetApi: " + e.message);
  }
}
