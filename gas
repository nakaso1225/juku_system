function findFirstValidDate(reigsterInfo) {
  const dayOfWeek = reigsterInfo.dayOfWeek;
  const startDate = reigsterInfo.startDate;
  const endDate = reigsterInfo.endDate;
  // indexOf を使ってインデックスを取得する
  const dayOfWeekIdx = DAY_OF_WEEK_LIST.indexOf(dayOfWeek[0]);
  if (dayOfWeekIdx === -1) {
    throw new Error("曜日の値が不適です");
  }
  const startDayIdx = startDate.getDay();
  const diff = (7 + dayOfWeekIdx - startDayIdx) % 7;
  const targetDate = new Date(startDate);
  targetDate.setDate(startDate.getDate() + diff);
  if (targetDate > endDate) {
    Logger.log(
      `validな日付がありません:\n[dayOfWeek] ${dayOfWeek}\n[startDate] ${startDate}\n[endDate] ${endDate}\n[targetDate] ${targetDate}`
    );
    return null;
  }
  return targetDate;
}
