/**
 * 複数ファイルにまたがって利用される (可能性がある) 定数を定義しておくファイル。
 *
 * gasでは変数・定数のスコープ (参照できる範囲) がファイルで区切られていないので、
 * 何もしなくても (特にimportなどしなくても) このファイルに定義した定数を別ファイルから呼び出せる。
 */
const properties = PropertiesService.getScriptProperties();
// Comiru
const COMIRU_API_BASE_URL = "https://api.comiru.com";
const COMIRU_SCHOOL_ID = properties.getProperty("COMIRU_SCHOOL_ID");
// 授業登録シート名
const REGISTER_LESSONS_SHEET_NAME = "授業登録";
// レギュラー授業登録シート名
const REGISTER_REGULAR_LESSONS_SHEET_NAME = "レギュラー授業登録";
// 授業削除シート名
const DELETE_LESSONS_SHEET_NAME = "授業削除";
// 授業差分検出用シート名
const DETECT_LESSON_CHANGES_SHEET_NAME = "授業差分検出";
const RECORD_PRE_CHANGE_LESSONS_SHEET_NAME = "授業情報記録";
// リストシート名
const COMA_LIST_SHEET_NAME = "授業コマリスト";
const SUBJECT_LIST_SHEET_NAME = "科目リスト";
const TEACHER_LIST_SHEET_NAME = "講師リスト";
const STUDENT_LIST_SHEET_NAME = "生徒リスト";
// Date型で利用するためのミリ秒表示
const ONE_DAY_IN_MILLISECONDS = 1000 * 60 * 60 * 24; // 1日のミリ秒数
const ONE_MONTH_IN_MILLISECONDS = ONE_DAY_IN_MILLISECONDS * 31; // 31日のミリ秒数
// 曜日一覧 (jsのDate Objectは日曜日始まり)
const DAY_OF_WEEK_LIST = ["日", "月", "火", "水", "木", "金", "土"];
function detectLessonChanges() {
  const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(
    DETECT_LESSON_CHANGES_SHEET_NAME
  );
  // 「授業情報記録」シートからデータを読み出す
  const { preChangeLessons, fetchLessonStartDate } = inputPreChangeLessons();
  // idをkeyとした授業Mapを作成
  const preChangeLessonsIdMap = createLessonIdMap(preChangeLessons);
  // シートに授業の取得開始日が書かれていない場合は、前月初日を設定する
  const today = new Date();
  const firstDayOfLastMonth = new Date(
    today.getFullYear(),
    today.getMonth() - 1,
    1
  );
  // 新しく授業情報をfetchする
  const postChangeLessons = fetchAllLessonsAfter(
    fetchLessonStartDate || firstDayOfLastMonth
  ); // 定義はrecordPreChangeLessons.gs
  // idで検索して「更新」「新規作成」「削除」の授業を見つける
  const { updatedLessons, createdLessons, deletedLessons } =
    categorizeLessonsByChangeType(preChangeLessonsIdMap, postChangeLessons);
  Logger.log(
    `更新: ${updatedLessons.length} 件\n新規作成: ${createdLessons.length} 件\n削除: ${deletedLessons.length} 件`
  );
  // 生徒名ごとに分けて表示
  const lessonChangesMap = categorizeLessonsByStudent(
    updatedLessons,
    createdLessons,
    deletedLessons
  );
  // 表示用にformat
  const formattedLessonChanges = formatLessonChanges(lessonChangesMap);
  Logger.log(
    `formattedLessonChanges:\n${JSON.stringify(
      formattedLessonChanges,
      null,
      2
    )}`
  );
  // シート内容をリセット
  const firstRow = 9;
  const lastRow = sheet.getLastRow();
  const lastColumn = sheet.getLastColumn();
  if (lastRow >= firstRow) {
    sheet
      .getRange(firstRow, 1, lastRow - firstRow + 1, lastColumn)
      .clearContent();
  }
  // データ表示
  if (formattedLessonChanges.length > 0) {
    sheet
      .getRange(
        firstRow,
        2,
        formattedLessonChanges.length,
        formattedLessonChanges[0].length
      )
      .setValues(formattedLessonChanges);
  }
  // 次回用に「授業情報記録」シートの内容を更新
  updateRecordPreChangeLessonSheetContent(
    postChangeLessons,
    firstDayOfLastMonth
  ); // 定義はrecordPreChangeLessons.gs
}
function inputPreChangeLessons() {
  const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(
    RECORD_PRE_CHANGE_LESSONS_SHEET_NAME
  );
  const firstRow = 2;
  const lastRow = sheet.getLastRow();
  const lastColumn = 8;
  const preChangeLessons = sheet
    .getRange(firstRow, 1, lastRow - firstRow + 1, lastColumn)
    .getDisplayValues();
  const fetchLessonStartDate = sheet.getRange(5, lastColumn + 2).getValue();
  Logger.log(`Fetched Lesson Start Date: ${fetchLessonStartDate}`);
  return { preChangeLessons, fetchLessonStartDate };
}
function createLessonIdMap(lessons) {
  // { [key]: value } 型のデータ構造。lessonIdを指定しての検索などが高速に行える
  const lessonIdMap = new Map();
  for (const lesson of lessons) {
    const lessonId = lesson[0];
    const lessonDetail = lesson.slice(1).join(",");
    lessonIdMap.set(lessonId, lessonDetail);
  }
  return lessonIdMap;
}
function categorizeLessonsByChangeType(
  preChangeLessonsIdMap,
  postChangeLessons
) {
  const updatedLessons = [];
  const createdLessons = [];
  for (const lesson of postChangeLessons) {
    const lessonId = lesson[0];
    const lessonDetail = lesson.slice(1).join(",");
    // preChangeLessonsに存在しないlesson情報の時 (新規作成)
    if (!preChangeLessonsIdMap.has(lessonId)) {
      createdLessons.push(lessonDetail);
      continue;
    }
    // preChangeLessonsに存在するlessonIdの情報である場合
    const preChangeLessonDetail = preChangeLessonsIdMap.get(lessonId);
    preChangeLessonsIdMap.delete(lessonId); // id一覧から削除しておく
    // lesson情報が変更されていた場合 (更新)
    if (preChangeLessonDetail !== lessonDetail) {
      updatedLessons.push([preChangeLessonDetail, lessonDetail]);
    }
  }
  // 削除されずに残っている内容は全て削除された授業情報
  const deletedLessons = [...preChangeLessonsIdMap.values()];
  return {
    updatedLessons,
    createdLessons,
    deletedLessons,
  };
}
function categorizeLessonsByStudent(
  updatedLessons,
  createdLessons,
  deletedLessons
) {
  const lessonChangesMap = new Map([
    ["❌ 生徒登録なし", []],
    ["異なる生徒", []],
  ]);
  for (const lessons of updatedLessons) {
    const preChangeLesson = parseLesson(lessons[0]);
    const postChangeLesson = parseLesson(lessons[1]);
    if (
      preChangeLesson[0] !== "❌ 生徒登録なし" &&
      postChangeLesson[0] !== "❌ 生徒登録なし" &&
      preChangeLesson[0] !== postChangeLesson[0]
    ) {
      // 異なる生徒に変更されていた場合は別途分けておく
      lessonChangesMap
        .get("異なる生徒")
        .push(formatRowLessonChange(preChangeLesson, postChangeLesson));
    }
    // 生徒名ごとに分ける
    const studentName =
      preChangeLesson[0] === "❌ 生徒登録なし"
        ? postChangeLesson[0]
        : preChangeLesson[0];
    if (!lessonChangesMap.has(studentName)) {
      lessonChangesMap.set(studentName, []);
    }
    lessonChangesMap
      .get(studentName)
      .push(formatRowLessonChange(preChangeLesson, postChangeLesson));
  }
  const preCreateLesson = ["", "", "", "", "", "", "なし"];
  for (const lesson of createdLessons) {
    const parsedLesson = parseLesson(lesson);
    const studentName = parsedLesson[0];
    if (!lessonChangesMap.has(studentName)) {
      lessonChangesMap.set(studentName, []);
    }
    lessonChangesMap
      .get(studentName)
      .push(formatRowLessonChange(preCreateLesson, parsedLesson));
  }
  const postDeleteLesson = ["なし", "", "", "", "", "", ""];
  for (const lesson of deletedLessons) {
    const parsedLesson = parseLesson(lesson);
    const studentName = parsedLesson[0];
    if (!lessonChangesMap.has(studentName)) {
      lessonChangesMap.set(studentName, []);
    }
    lessonChangesMap
      .get(studentName)
      .push(formatRowLessonChange(parsedLesson, postDeleteLesson));
  }
  return lessonChangesMap;
}
function parseLesson(lessonStr) {
  const lesson = lessonStr.split(",");
  return lesson;
}
function formatRowLessonChange(preChangeLesson, postChangeLesson) {
  return preChangeLesson.concat(["→"]).concat(postChangeLesson);
}
function formatLessonChanges(lessonChangesMap) {
  const studentLessLessonChanges = lessonChangesMap.get("❌ 生徒登録なし");
  const differentStudentLessonChanges = lessonChangesMap.get("異なる生徒");
  lessonChangesMap.delete("❌ 生徒登録なし");
  lessonChangesMap.delete("異なる生徒");
  Logger.log(
    `生徒登録なし:\n${JSON.stringify(studentLessLessonChanges, null, 2)}`
  );
  Logger.log(
    `異なる生徒:\n${JSON.stringify(differentStudentLessonChanges, null, 2)}`
  );
  const formattedLessonChanges = [];
  const emptyRow = Array.from({ length: 15 }, () => "");
  for (const key of lessonChangesMap.keys()) {
    const lessonChanges = lessonChangesMap.get(key);
    formattedLessonChanges.push(...lessonChanges);
    formattedLessonChanges.push(emptyRow);
  }
  if (studentLessLessonChanges.length > 0) {
    formattedLessonChanges.push(...studentLessLessonChanges);
    formattedLessonChanges.push(emptyRow);
  }
  if (differentStudentLessonChanges.length > 0) {
    formattedLessonChanges.push(...differentStudentLessonChanges);
  }
  return formattedLessonChanges;
}
function recordPreChangeLessons() {
  const today = new Date();
  const firstDayOfLastMonth = new Date(
    today.getFullYear(),
    today.getMonth() - 1,
    1
  );
  const lessons = fetchAllLessonsAfter(firstDayOfLastMonth);
  updateRecordPreChangeLessonSheetContent(lessons, firstDayOfLastMonth);
}
function fetchAllLessonsAfter(date) {
  let allSeats = [];
  let startDateObj = date;
  while (true) {
    // 同じ月の最終日
    const endOfMonthObj = new Date(
      startDateObj.getFullYear(),
      startDateObj.getMonth() + 1,
      0
    );
    // 次の月の1日
    const firstOfNextMonthObj = new Date(
      startDateObj.getFullYear(),
      startDateObj.getMonth() + 1,
      1
    );
    // formatDate関数の定義は utils.gs
    const formattedStartDate = formatDate(startDateObj);
    const formattedEndDate = formatDate(endOfMonthObj);
    // fetchSeatsの定義は searchLessons.gs
    const seatsData = fetchSeats(
      undefined,
      undefined,
      formattedStartDate,
      formattedEndDate
    );
    if (seatsData.length === 0) {
      break;
    }
    const formattedSeats = seatsData
      .map((seatsByDate) => {
        return seatsByDate.seats.map((seat) => {
          const student = seat.seat_students?.[0];
          const teacher = seat.teacher;
          return [
            seat.id.toString(),
            student ? student.student_name : "❌ 生徒登録なし",
            teacher ? teacher.name : "❌ 講師登録なし",
            student ? student.subject : "❌ 生徒登録なし",
            seat.date,
            seat.start_time,
            seat.end_time,
            student
              ? student.absent
                ? "❌ 欠席"
                : "◯ 出席"
              : "❌ 生徒登録なし",
          ];
        });
      })
      .flat();
    allSeats = allSeats.concat(formattedSeats);
    startDateObj = firstOfNextMonthObj;
  }
  return allSeats;
}
function updateRecordPreChangeLessonSheetContent(
  lessons,
  fetchLessonStartDate
