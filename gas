    coma.id,
    coma.coma_no,
    coma.time_start,
    coma.time_end,
    `[${coma.time_start.padStart(5, " ")} - ${coma.time_end.padStart(
      5,
      " "
    )}] ${coma.coma_no}`,
  ]);
  Logger.log("Formatted coma data: " + JSON.stringify(formattedData, null, 2));
