  ScriptApp.newTrigger("updateComaList").timeBased().everyHours(12).create();
  ScriptApp.newTrigger("updateSubjectList").timeBased().everyHours(12).create();
  ScriptApp.newTrigger("updateTeacherList").timeBased().everyHours(12).create();
  ScriptApp.newTrigger("updateStudentList").timeBased().everyHours(12).create();
